{
	"name": "{{ cookiecutter.repo_name }}_env",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},
	"workspaceFolder": "/code",
	"workspaceMount": "source=${localWorkspaceFolder},target=/code,type=bind,consistency=cached",
	// "mounts": [
	//     "source=${localWorkspaceFolder}/data/raw,target=/data/raw,type=bind,readonly",
	//     "source=${localWorkspaceFolder}/data/processed,target=/data/processed,type=bind",
	//     "source=${localWorkspaceFolder}/models,target=/models,type=bind"
	// ],
	"runArgs": ["--gpus", "all"],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.black-formatter",
				"ms-python.vscode-pylance",
				"KevinRose.vsc-python-indent",
				"ms-toolsai.jupyter",
				"ms-python.isort"
			],
			"settings": {
				"python.formatting.provider": "black",
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.organizeImports": "always"
				},
				"isort.args": [
					"--profile",
					"black"
				]
			}
		}
	}
}
